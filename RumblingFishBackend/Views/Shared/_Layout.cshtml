<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Admin</title>
</head>
<body>
    @RenderBody()
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form asp-controller="Login" asp-action="Logout" method="post">
            <button type="submit">Log out</button>
        </form>
    }
</body>
</html>
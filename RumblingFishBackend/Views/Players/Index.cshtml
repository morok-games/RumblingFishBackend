@using Microsoft.AspNetCore.Routing
@{
    ViewData["Title"] = "Players";
}

@model RumblingFishBackend.Models.DTO.Admin.PlayerListViewModel

@{
    var routeValues = new Dictionary<string, string?>
    {
        ["pageSize"] = Model.PageSize.ToString(),
        ["countryCode"] = Model.Filter.CountryCode,
        ["nickname"] = Model.Filter.Nickname,
        ["dateFrom"] = Model.Filter.DateFrom?.ToString("yyyy-MM-dd"),
        ["dateTo"] = Model.Filter.DateTo?.ToString("yyyy-MM-dd"),
    };
}

<h1>Players</h1>

<form method="get" class="d-flex align-items-end gap-2 flex-wrap mb-3">
    <div>
        <label class="form-label">Rows per page</label>
        <select name="pageSize" class="form-select" onchange="this.form.submit()">
            @foreach (var size in new[] { 10, 20, 50, 100 })
            {
                <option value="@size" selected="@(size == Model.PageSize ? "selected" : null)">@size</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label">Country</label>
        <select name="countryCode" class="form-select">
            <option value="">All countries</option>
            @foreach (var country in Model.AvailableCountries)
            {
                <option value="@country.Code" selected="@(country.Code == Model.Filter.CountryCode ? "selected" : null)">@country.Name (@country.Code)</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label">Nickname contains</label>
        <input type="text" name="nickname" class="form-control" value="@Model.Filter.Nickname" placeholder="player" />
    </div>
    <div>
        <label class="form-label">Created from</label>
        <input type="date" name="dateFrom" class="form-control" value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <label class="form-label">Created to</label>
        <input type="date" name="dateTo" class="form-control" value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" />
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Apply</button>
        <a href="@Url.Action("Index", new { pageSize = Model.PageSize })" class="btn btn-outline-secondary">Reset</a>
    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>#</th>
            <th>Country</th>
            <th>Player</th>
            <th>Levels</th>
            <th>Created (UTC)</th>
            <th>Score</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var player in Model.Players)
        {
            <tr>
                <td>@player.Rank</td>
                <td>
                    @if (!string.IsNullOrEmpty(player.CountryCode))
                    {
                        <img src="https://flagcdn.com/24x18/@(player.CountryCode.ToLower()).png" alt="@player.CountryCode" title="@player.CountryCode" />
                    }
                </td>
                <td>@player.Nickname</td>
                <td>@player.CompletedLevels/@player.TotalLevels</td>
                <td>@player.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                <td>@player.Score</td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex justify-content-between align-items-center mb-3">
    <nav>
        <ul class="pagination">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new RouteValueDictionary(routeValues) { ["page"] = Model.CurrentPage - 1 })">Previous</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new RouteValueDictionary(routeValues) { ["page"] = i })">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="@Url.Action("Index", new RouteValueDictionary(routeValues) { ["page"] = Model.CurrentPage + 1 })">Next</a>
            </li>
        </ul>
    </nav>
</div>